{
  "name": "weathercompare",
  "version": "0.1.0",
  "private": true,
  "description": "Premium multi-source weather comparison platform for Italy and Europe.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "0.427.0",
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "recharts": "2.15.4",
    "resend": "^6.28.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/leaflet": "^1.9.12",
    "@types/node": "20.14.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "^15.5.26",
    "postcss": "8.4.40",
    "tailwindcss": "3.4.7",
    "typescript": "5.5.4",
    "wrangler": "^4.141.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}

+  h ^= h >>> 16;
+  h = Math.imul(h, 2246822507);
+  h ^= h >>> 13;
+  h = Math.imul(h, 3266489909);
+  h = (h ^ (h >>> 16)) >>> 0;
+  return options[h % options.length]!;
 }
 
 const r = Math.round;

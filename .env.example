# =============================================================================
# WeatherCompare — Environment Configuration
# Copy this file to .env.local for local development, or configure the same
# keys in your hosting provider's dashboard (Vercel/Netlify/etc.) for
# production. Never commit a real .env or .env.local file.
# =============================================================================

# --- Site identity -----------------------------------------------------------
# Public brand name, shown in the header, footer, and metadata.
# Safe to rename ("MeteoCompare", "SkySource", etc.) — used everywhere via
# config/site.ts instead of being hardcoded in components.
NEXT_PUBLIC_SITE_NAME=WeatherCompare

# Canonical production URL (no trailing slash). Used for canonical tags,
# Open Graph URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.weathercompare.example

# --- Demo mode -----------------------------------------------------------
# When true (default), the app runs entirely on deterministic mock weather
# data — no API keys required. Set to false only once real provider keys
# below are configured and verified.
DEMO_MODE=true

# --- Weather providers ---------------------------------------------------
# Each key powers one live adapter in lib/providers/. Leave all three blank
# while DEMO_MODE=true. You must verify each provider's current commercial
# licensing, attribution requirements and rate limits before enabling it
# in production — see /data-sources.
#
# Provider A — OpenWeatherMap (openweathermap.org/api). Free tier: 1,000
# calls/day, commercial use permitted with attribution (verify current
# terms). Get a key at openweathermap.org/api -> Sign Up -> API keys.
SECOND_WEATHER_API_KEY=

# Provider B — WeatherAPI.com (weatherapi.com). Free tier: 1,000,000
# calls/month, commercial use permitted (verify current terms). Get a key
# at weatherapi.com -> Sign Up -> your dashboard.
THIRD_WEATHER_API_KEY=

# Provider C — Open-Meteo (open-meteo.com). No key required for the free
# non-commercial tier — this provider works automatically once
# DEMO_MODE=false, even with this left blank. Only set WEATHER_API_KEY if
# you move to Open-Meteo's paid commercial plan later.
WEATHER_API_KEY=

# --- Geocoding -------------------------------------------------------------
# Used by the location search autocomplete. Any provider implementing
# lib/providers/geocoding.ts's contract works (e.g. Open-Meteo Geocoding,
# OpenCage, Google Geocoding). Leave blank to use the bundled demo city list.
GEOCODING_API_KEY=

# --- Rate limiting / caching (optional) -------------------------------------
# How long (seconds) live weather responses are cached, both at the fetch()
# level and as the ISR revalidate window for city pages. Defaults to 5400
# (90 min) — sized to stay under OpenWeatherMap's free 1,000 calls/day cap
# across the ~29 seed cities. See the comment on siteConfig.weatherCacheSeconds
# in config/site.ts for the exact math before changing this.
WEATHER_CACHE_SECONDS=5400

# --- Weather map ------------------------------------------------------------
# Powers the live temperature/precipitation/wind/clouds tile overlays on the
# Weather Map section (see components/WeatherMapLeaflet.tsx). Uses
# OpenWeatherMap's map tile service, which is designed to be called directly
# from the browser — so, unlike the other provider keys above, this one is
# intentionally public (NEXT_PUBLIC_) and safe to expose client-side. You can
# reuse the same value as SECOND_WEATHER_API_KEY. Leave blank to still show a
# real interactive map (pan/zoom, OpenStreetMap base layer, city marker) with
# the live weather overlays disabled.
NEXT_PUBLIC_OWM_MAP_KEY=

# --- Analytics (optional) ---------------------------------------------------
# Generic analytics ID consumed by lib/analytics.ts. Works with GA4
# ("G-XXXXXXX"), a Plausible domain, or any provider you wire in — analytics
# only loads after the user accepts the "Analytics" cookie category.
ANALYTICS_ID=

# --- Contact form (optional) ------------------------------------------------
# Resend (resend.com) API key that powers app/api/contact/route.ts. Until
# this is set, the contact form clearly tells users it cannot deliver
# messages yet, rather than silently dropping them. Requires verifying
# weathercompare.eu as a sending domain in Resend first (a couple of DNS
# records — same idea as the privacy@ email forwarding setup).
CONTACT_FORM_API_KEY=

# Where contact form submissions are delivered. Defaults to
# contact@weathercompare.eu if unset — any @weathercompare.eu address works
# once the wildcard ImprovMX forwarding alias is set up, since it'll forward
# straight to your real inbox either way.
CONTACT_FORM_TO_EMAIL=

# --- Photos (optional but recommended) ---------------------------------------
# Powers real, licensed stock photos on weather/guide pages and inside the
# Pinterest portrait card images (see lib/providers/photos.ts and
# lib/pinImageCard.tsx) — free for commercial use under the Pexels License,
# no attribution legally required (we credit the photographer anyway as good
# practice). Without this set, pages simply render without a hero photo —
# nothing breaks. Get a free key instantly at pexels.com/api (no approval
# wait, no credit card).
PEXELS_API_KEY=

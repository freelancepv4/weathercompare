# =============================================================================
# WeatherCompare — Environment Configuration
# Copy this file to .env.local for local development, or configure the same
# keys in your hosting provider's dashboard (Vercel/Netlify/etc.) for
# production. Never commit a real .env or .env.local file.
# =============================================================================

# --- Site identity -----------------------------------------------------------
# Public brand name, shown in the header, footer, and metadata.
# Safe to rename ("MeteoCompare", "SkySource", etc.) — used everywhere via
# config/site.ts instead of being hardcoded in components.
NEXT_PUBLIC_SITE_NAME=WeatherCompare

# Canonical production URL (no trailing slash). Used for canonical tags,
# Open Graph URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.weathercompare.example

# --- Demo mode -----------------------------------------------------------
# When true (default), the app runs entirely on deterministic mock weather
# data — no API keys required. Set to false only once real provider keys
# below are configured and verified.
DEMO_MODE=true

# --- Weather providers ---------------------------------------------------
# Each key powers one live adapter in lib/providers/. Leave all three blank
# while DEMO_MODE=true. You must verify each provider's current commercial
# licensing, attribution requirements and rate limits before enabling it
# in production — see /data-sources.
#
# Provider A — OpenWeatherMap (openweathermap.org/api). Free tier: 1,000
# calls/day, commercial use permitted with attribution (verify current
# terms). Get a key at openweathermap.org/api -> Sign Up -> API keys.
SECOND_WEATHER_API_KEY=

# Provider B — WeatherAPI.com (weatherapi.com). Free tier: 1,000,000
# calls/month, commercial use permitted (verify current terms). Get a key
# at weatherapi.com -> Sign Up -> your dashboard.
THIRD_WEATHER_API_KEY=

# Provider C — Open-Meteo (open-meteo.com). No key required for the free
# non-commercial tier — this provider works automatically once
# DEMO_MODE=false, even with this left blank. Only set WEATHER_API_KEY if
# you move to Open-Meteo's paid commercial plan later.
WEATHER_API_KEY=

# --- Geocoding -------------------------------------------------------------
# Used by the location search autocomplete. Any provider implementing
# lib/providers/geocoding.ts's contract works (e.g. Open-Meteo Geocoding,
# OpenCage, Google Geocoding). Leave blank to use the bundled demo city list.
GEOCODING_API_KEY=

# --- Weather map (optional, future) ----------------------------------------
# Powers the tile layers behind the Weather Map section (see
# components/WeatherMap.tsx). e.g. RainViewer, Windy API, OpenWeatherMap
# Maps. Leave blank to show the informational placeholder.
WEATHER_MAP_API_KEY=

# --- Analytics (optional) ---------------------------------------------------
# Generic analytics ID consumed by lib/analytics.ts. Works with GA4
# ("G-XXXXXXX"), a Plausible domain, or any provider you wire in — analytics
# only loads after the user accepts the "Analytics" cookie category.
ANALYTICS_ID=

# --- Contact form (optional) ------------------------------------------------
# Endpoint/service used by app/contact — e.g. a transactional email API key
# (Resend, Postmark, SendGrid) or a form backend (Formspree). Until this is
# set, the contact form clearly tells users it cannot deliver messages yet.
CONTACT_FORM_API_KEY=
